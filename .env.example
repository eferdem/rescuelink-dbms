# Copy to .env (or use these values in your shell) and adjust as needed.
#
# The application reads DATABASE_URL first; if it is absent it falls back to
# the PG* variables below. The defaults match the project-local cluster that
# scripts/init_cluster.ps1 creates on port 5433.
DATABASE_URL=postgresql://rescue_admin:rescue_dev_pw@127.0.0.1:5433/rescuelink

PGHOST=127.0.0.1
PGPORT=5433
PGUSER=rescue_admin
PGPASSWORD=rescue_dev_pw
PGDATABASE=rescuelink

# Flask (used by app/app.py)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=1
